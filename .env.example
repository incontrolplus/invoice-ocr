# Bulgarian Invoice OCR — Environment Configuration
# Copy this file to .env and customize values for your deployment.

# PostgreSQL Database Credentials
POSTGRES_USER=invoice_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=invoice_db

# Webhook HMAC-SHA256 Signing Secret
WEBHOOK_SECRET=change_me_to_a_random_secret_key

# Webhook HTTP timeout (seconds)
WEBHOOK_TIMEOUT_SEC=10.0

# Optional: API Key Authentication (leave empty to disable)
# When set, all API endpoints except /health, /docs, /dashboard require X-API-Key header
API_KEY=

# Optional: CORS Allowed Origins (comma-separated, default: * for development)
# In production, restrict to your ERP/dashboard domains
CORS_ALLOWED_ORIGINS=*

# Optional: Allowed batch directory roots (comma-separated)
# ALLOWED_BATCH_ROOT=/data/invoices

# ---------------------------------------------------------------------------
# Goal 1: Zero-Touch Email & Cloud Watcher Ingestion Configuration
# ---------------------------------------------------------------------------

# Inbound Email Webhook Secret (X-Ingest-Token or ?token=...)
# Set this to secure /api/v1/ingest/email from unauthorized post requests
EMAIL_INGEST_SECRET=

# Minimum attachment size in bytes to process (default 10240 = 10KB)
# Filters out small email signature badges, icons, social media logos
MIN_ATTACHMENT_SIZE_BYTES=10240

# Human-In-The-Loop (HITL) Web Dashboard Base URL
HITL_BASE_URL=http://localhost:8000

# Directory / Cloud Storage Watcher (Google Drive, Nextcloud, local network share)
WATCHER_ENABLED=false
WATCH_DIR=watch_invoices
WATCHER_POLL_INTERVAL_SEC=2.0
WATCHER_WEBHOOK_URL=
WATCHER_NOTIFICATION_EMAIL=

# IMAP Poller (e.g. invoices@openbalancer.com)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true

# Reverse Notifications: Outbound Email Confirmation (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=invoices@openbalancer.com

# Reverse Notifications: Instant Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reverse Notifications: Instant Slack Alerts
SLACK_WEBHOOK_URL=
