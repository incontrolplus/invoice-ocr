# Bulgarian Invoice OCR — Environment Configuration
# Copy this file to .env and customize values for your deployment.

# PostgreSQL Database Credentials
POSTGRES_USER=invoice_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=invoice_db

# Webhook HMAC-SHA256 Signing Secret
WEBHOOK_SECRET=change_me_to_a_random_secret_key

# Webhook HTTP timeout (seconds)
WEBHOOK_TIMEOUT_SEC=10.0

# Optional: API Key Authentication (leave empty to disable)
# When set, all API endpoints except /health, /docs, /dashboard require X-API-Key header
API_KEY=

# Optional: CORS Allowed Origins (comma-separated, default: * for development)
# In production, restrict to your ERP/dashboard domains
CORS_ALLOWED_ORIGINS=*

# Optional: Allowed batch directory roots (comma-separated)
# ALLOWED_BATCH_ROOT=/data/invoices
